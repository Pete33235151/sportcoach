# Keine echten Zugangsdaten in Git speichern!
SPORTCOACH_DEMO_MODE=true
SPORTCOACH_DATABASE_URL=sqlite:///./sportcoach.sqlite3
SPORTCOACH_AUTO_SYNC=false
SPORTCOACH_SYNC_INTERVAL_MINUTES=180
SPORTCOACH_GARMIN_PERSONAL_API_KEY=
# Optional: inoffizieller Garmin-Connect-Schreibadapter, niemals standardmaessig aktiv
SPORTCOACH_ENABLE_GARMIN_WRITE=false
SPORTCOACH_GARMIN_EMAIL=
SPORTCOACH_GARMIN_PASSWORD=
SPORTCOACH_GARMIN_TOKEN_DIR=.garmin-tokens
# Fuer Internet-/LAN-Zugriff MUSS ein Zugriffsschutz davor geschaltet sein.
SPORTCOACH_ACCESS_TOKEN=
